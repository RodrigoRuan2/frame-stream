<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>Frame</AssemblyName><Version>0.1.0</Version><ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishReadyToRun>true</PublishReadyToRun><DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Integration/**/*.cs" />
    <PackageReference Include="SIPSorcery" Version="10.0.17" />
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Concentus" Version="2.2.2" />
  </ItemGroup>
</Project>
